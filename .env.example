# Telegram API credentials
# Obtén api_id y api_hash en https://my.telegram.org/apps
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=tu_api_hash_aqui

# Canales de Telegram (separados por coma)
# Pueden ser usernames públicos o IDs numéricos de canales privados
# Ejemplo un canal: TELEGRAM_CHANNELS=durov
# Ejemplo varios canales: TELEGRAM_CHANNELS=durov,-1001234567890,@mychannel
TELEGRAM_CHANNELS=mi_canal_aqui

# Configuración de notificaciones
NOTIFICATION_EMAIL=admin@example.com

# VirusTotal API key (opcional, solo si usas engine: virustotal)
# Obtén tu API key en https://www.virustotal.com/gui/my-apikey
VT_API_KEY=
